# Mobile app settings. Copy to apps/mobile/.env.local (git-ignored). Not secrets: values starting
# with EXPO_PUBLIC_ are built into the app, so never put a key or password here.

# Where the backend (apps/web) runs. On the laptop: run `pnpm dev`, then use the laptop's Wi-Fi
# address (Windows: `ipconfig` → "IPv4 Address"), e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=
