{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": [
    "AUTH_SECRET",
    "DATABASE_URL",
    "MONNIFY_*",
    "OTP_SENDER",
    "TEST_DATABASE_URL",
    "VTPASS_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": []
    },
    "lint": {},
    "typecheck": {}
  }
}
