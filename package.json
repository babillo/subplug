{
  "name": "sauritop-monorepo",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "dev:mobile": "pnpm --filter mobile start",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:check": "pnpm --filter @repo/db check",
    "db:generate": "pnpm --filter @repo/db generate",
    "db:migrate": "pnpm --filter @repo/db migrate",
    "db:seed": "pnpm --filter @repo/core seed",
    "db:studio": "pnpm --filter @repo/db studio",
    "vtpass:check": "pnpm --filter @repo/core vtpass:check",
    "jobs:run": "pnpm --filter @repo/core jobs:run",
    "orders:recheck": "pnpm --filter @repo/core orders:recheck",
    "orders:try": "pnpm --filter @repo/core orders:try",
    "funding:account": "pnpm --filter @repo/core funding:account",
    "funding:reconcile": "pnpm --filter @repo/core funding:reconcile",
    "admin:grant": "pnpm --filter @repo/core admin:grant",
    "admin:reset-2fa": "pnpm --filter @repo/core admin:reset-2fa",
    "deploy:staging": "pnpm --filter web deploy:staging",
    "cf:preview": "pnpm --filter web cf:preview"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3"
  }
}
