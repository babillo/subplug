{
  "name": "@repo/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run integration",
    "vtpass:check": "node --disable-warning=ExperimentalWarning src/scripts/vtpass-check.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "seed": "node --disable-warning=ExperimentalWarning src/scripts/seed.ts",
    "orders:recheck": "node --disable-warning=ExperimentalWarning src/scripts/recheck-orders.ts",
    "orders:try": "node --disable-warning=ExperimentalWarning src/scripts/try-order.ts",
    "funding:account": "node --disable-warning=ExperimentalWarning src/scripts/funding-account.ts",
    "funding:reconcile": "node --disable-warning=ExperimentalWarning src/scripts/reconcile-funding.ts"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/shared": "workspace:*",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@repo/config-eslint": "workspace:*",
    "@repo/config-typescript": "workspace:*",
    "@types/node": "^22",
    "eslint": "^9.39.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
