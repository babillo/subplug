# Laptop: copy this file to .env.local (repo root) and fill it in. .env.local is git-ignored.
# Cloud: add the same names in the cloud environment's settings instead; no file needed.

# Neon connection string for the DEV branch (never production). Get it from Neon's "Connect" button.
# Example shape: postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# A SEPARATE database for automated tests: they delete data. Never the same as DATABASE_URL.
# Laptop: a Neon "test" branch. Cloud: a throwaway local PostgreSQL (see README).
TEST_DATABASE_URL=

VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=

# Monnify (wallet funding). Sandbox keys: app.monnify.com → Developer. API keys start with MK_TEST_.
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

# TEMPORARY: lets POST /api/orders accept an x-test-user-id header until real sign-in exists.
# Laptop only. Ignored in production builds.
ALLOW_TEST_AUTH=
